#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "${REPO_ROOT}"

if [[ -d "${HOME}/.local/bin" && ":${PATH}:" != *":${HOME}/.local/bin:"* ]]; then
    export PATH="${HOME}/.local/bin:${PATH}"
fi
if [[ -d "${HOME}/go/bin" && ":${PATH}:" != *":${HOME}/go/bin:"* ]]; then
    export PATH="${HOME}/go/bin:${PATH}"
fi

echo "=========================================="
echo "Running pre-commit checks..."
echo "=========================================="

echo "--> [1/8] Verifying module dependencies..."
make tidy-check

echo "--> [2/8] Checking code formatting..."
make fmt-check

echo "--> [3/8] Running linter and static analysis..."
make lint

echo "--> [4/8] Running govulncheck..."
make vulncheck

echo "--> [5/8] Linting Dockerfile..."
make hadolint

echo "--> [6/8] Running unit tests with race detector..."
make test

echo "--> [7/8] Running TruffleHog secret scan..."
make secrets

echo "--> [8/8] Running Trivy vulnerability scan..."
make trivy

echo "=========================================="
echo "All pre-commit checks passed!"
echo "=========================================="
